<?xml version="1.0" encoding="utf-8"?>
<!-- The 11 tip rows of S2. Shared by layout/ and layout-port/ (same IDs as the Figma layers). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/category_tip_list_rows"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/divider_16"
    android:orientation="vertical"
    android:showDividers="middle">

    <LinearLayout
        android:id="@+id/category_tip_row_1"
        style="@style/Tips.ListRow">

        <ImageView
            style="@style/Tips.RowIcon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lightbulb" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/category_tip_row_1_title"
                style="@style/Tips.Text.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tip_1_title" />

            <TextView
                android:id="@+id/category_tip_row_1_subtitle"
                style="@style/Tips.Text.RowSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tip_1_subtitle" />
        </LinearLayout>

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/white" />
    </LinearLayout>

