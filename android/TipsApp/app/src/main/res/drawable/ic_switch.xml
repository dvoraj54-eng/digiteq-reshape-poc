<?xml version="1.0" encoding="utf-8"?>
<!-- Toggle switch 88 x 48, knob 40 with 4 dp margin. selected = on: green track, dark knob on the right. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <size android:width="88dp" android:height="48dp" />
                    <solid android:color="@color/accent" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item
                android:width="40dp"
                android:height="40dp"
                android:gravity="end|center_vertical"
                android:right="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/on_accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <size android:width="88dp" android:height="48dp" />
                    <solid android:color="@color/white_12" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item
                android:width="40dp"
                android:height="40dp"
                android:gravity="start|center_vertical"
                android:left="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/white_60" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
