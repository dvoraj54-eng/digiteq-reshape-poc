<?xml version="1.0" encoding="utf-8"?>
<!-- Radio: ring, and ring + dot when selected (checked = accent) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/accent" />
                </shape>
            </item>
            <item android:bottom="7dp" android:left="7dp" android:right="7dp" android:top="7dp">
                <shape android:shape="oval">
                    <solid android:color="@color/accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="@color/white_40" />
        </shape>
    </item>
</selector>
